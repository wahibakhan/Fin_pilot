# Copy this file to .env and fill in real values.
# Never commit .env with real secrets — see docs/environment-variables.md (Phase 11).

# --- Backend (backend/.env or repo-root .env, both are read by pydantic-settings) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://finpilot:finpilot@localhost:5432/finpilot
# Only needed when sharing a database with another, unrelated application.
# DB_SCHEMA=finpilot

JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]

# AI_PROVIDER selects the model backend; set the matching *_API_KEY below.
# Supported: "openai" (OPENAI_API_KEY) or "google_genai" (GOOGLE_API_KEY).
AI_PROVIDER=openai
AI_MODEL=gpt-5
OPENAI_API_KEY=replace-with-your-own-key
GOOGLE_API_KEY=replace-with-your-own-key

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
